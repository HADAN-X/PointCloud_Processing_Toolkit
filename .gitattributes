# Keep repository text files consistent across Windows and Linux.
* text=auto

*.cpp  text eol=lf
*.cc   text eol=lf
*.cxx  text eol=lf
*.h    text eol=lf
*.hpp  text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.py   text eol=lf
*.sh   text eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Images, archives, and documents are binary assets. PLY is intentionally not
# forced to binary because the test suite will also contain reviewable ASCII PLY.
*.pcd  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary
*.7z   binary
